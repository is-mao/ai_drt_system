# ===========================================
# DRT System Environment Configuration
# ===========================================

# --- Remote Database (Online Mode) ---
# Set this to enable Online mode (Supabase / PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- App Settings ---
# FLASK_DEBUG=1 for development, 0 for production
FLASK_DEBUG=0

# Secret key (auto-generated if not set)
# DRT_SECRET_KEY=your-random-secret-key

# --- Google Gemini AI ---
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
