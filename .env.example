# ===========================================
# DRT System — Production Configuration
# ===========================================

# --- App ---
FLASK_DEBUG=0
DRT_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# --- AI API Keys (at least one required) ---
# Get Gemini key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Get GLM key from: https://open.bigmodel.cn
GLM_API_KEY=your_glm_api_key_here

# --- Admin seed account (created on first start) ---
SEED_SUPERADMIN_USER=admin
SEED_SUPERADMIN_PASS=change_me

# --- CORS (your production domain) ---
CORS_ORIGINS=https://your-domain.com
