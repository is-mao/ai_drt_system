# Database Configuration
# Use 'sqlite' for local file-based DB (no setup needed)
# Use 'mysql' for shared/production DB
DRT_DB_TYPE=sqlite

# MySQL settings (only needed if DRT_DB_TYPE=mysql)
DRT_MYSQL_HOST=localhost
DRT_MYSQL_PORT=3306
DRT_MYSQL_USER=root
DRT_MYSQL_PASSWORD=your_password_here
DRT_MYSQL_DB=ai_drt_system

# Google Gemini API Key (for AI log analysis & beautification)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
